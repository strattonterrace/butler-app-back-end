# ── Django ──
SECRET_KEY=replace-me-with-a-50-char-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=butler_api.settings.development

# ── Database ──
# Local: postgresql://butler:butler@localhost:5432/butler_dev
# Render: filled automatically via the linked database service
DATABASE_URL=postgresql://butler:butler@localhost:5432/butler_dev

# ── JWT ──
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── CORS ──
# Comma-separated list of allowed origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Frontend URL (used in email links, password reset redirects) ──
FRONTEND_URL=http://localhost:5173

# ── Stripe (M2 — live) ──
# Secret + publishable keys: Stripe Dashboard → Developers → API keys.
# Price ID: the recurring $199/month price on the Butler Membership product.
# Webhook secret: Developers → Webhooks → endpoint
#   https://<backend-host>/api/v1/subscriptions/webhook/
# Blank keys = billing endpoints return 502 PAYMENT_SERVICE_ERROR (dev-safe).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ── Email / Resend (M3 — leave blank in M1) ──
RESEND_API_KEY=
FROM_EMAIL=hello@butlerapp.com
FROM_NAME=Butler

# ── Image storage / Cloudinary (M3) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
